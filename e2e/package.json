{
  "name": "pez-digital-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "UI/E2E-тесты Комнаты ПЭЗ. Digital (Playwright)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:desktop": "playwright test --project=desktop",
    "test:mobile": "playwright test --project=mobile",
    "test:bundle-flow": "playwright test --project=desktop tests/fr-13-test-bundles.spec.ts",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
